{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FC Architecture Model",
  "type": "object",
  "required": ["module", "external_interfaces", "dependency_interfaces"],
  "properties": {
    "module": { "type": "string" },
    "grounding_modules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "external_interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/interface" }
    },
    "dependency_interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/interface" }
    },
    "config_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["formal", "reserved", "conditional", "pending_confirm"]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "interface": {
      "type": "object",
      "required": ["name", "prototype", "sync", "reentrancy", "status"],
        "properties": {
          "name": { "type": "string" },
          "prototype": { "type": "string" },
          "sync": { "type": "string" },
          "reentrancy": { "type": "string" },
        "status": {
            "type": "string",
            "enum": ["formal", "reserved", "conditional", "pending_confirm"]
          },
          "trace_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
  },
  "additionalProperties": false
}
