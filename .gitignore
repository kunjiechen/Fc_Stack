# Ignore everything by default
/*
/*/

# Except .gitignore itself
!.gitignore

# Except .claude/skills directory tree
!.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/**

# Universal ignores (apply everywhere, including unignored dirs)
.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.cache/
